# Copy to .env for local development. Never commit the real .env.
#
# Production values are NOT set here — they live as Cloudflare Worker
# secrets (`wrangler secret put NAME`) and a Hyperdrive binding, not in a
# file. See wrangler.toml + the deployment notes for details.

# ── Database (local dev only — production uses the Hyperdrive binding) ─────
# Direct Supabase Postgres connection string. Either scheme works:
#   postgresql://user:password@host:5432/dbname
#   postgresql+asyncpg://user:password@host:5432/dbname   (legacy form, still accepted)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pawnpro

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Seeds boss accounts on first migrate.py run ONLY (existing users/passwords
# are never touched). Format: "username:password:Display Name;user2:pass2:Name2"
BOSS_ACCOUNTS=STORE001:changeme:Store Owner

# ── Chatbot (Gemini / Google AI Studio) ─────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite

# ── CORS ─────────────────────────────────────────────────────────────────────
# The deployed frontend origin (e.g. a Cloudflare Pages URL). localhost:5173
# is always allowed for local Vite dev, no need to list it here.
FRONTEND_URL=https://your-frontend.pages.dev
# Comma-separated list of any additional allowed origins.
# CORS_EXTRA_ORIGINS=
